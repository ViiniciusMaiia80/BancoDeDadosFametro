"livro" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>livro</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_livro"><FONT POINT-SIZE="10"><B>id_livro</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="isbn"><FONT POINT-SIZE="10">isbn</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo"><FONT POINT-SIZE="10">titulo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ano_publicacao"><FONT POINT-SIZE="10">ano_publicacao</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="edicao"><FONT POINT-SIZE="10">edicao</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_editora"><FONT POINT-SIZE="10">id_editora</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_categoria"><FONT POINT-SIZE="10">id_categoria</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>FK</B></FONT></TD></TR></TABLE>>];
