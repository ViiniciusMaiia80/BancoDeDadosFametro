"reserva" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF2CC"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>reserva</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_reserva"><FONT POINT-SIZE="10"><B>id_reserva</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_livro"><FONT POINT-SIZE="10">id_livro</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_reserva"><FONT POINT-SIZE="10">data_reserva</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR></TABLE>>];
"multa" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FBE5D6"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>multa</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_multa"><FONT POINT-SIZE="10"><B>id_multa</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_emprestimo"><FONT POINT-SIZE="10">id_emprestimo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>FK,UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dias_atraso"><FONT POINT-SIZE="10">dias_atraso</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valor"><FONT POINT-SIZE="10">valor</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_geracao"><FONT POINT-SIZE="10">data_geracao</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_pagamento"><FONT POINT-SIZE="10">data_pagamento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR></TABLE>>];
