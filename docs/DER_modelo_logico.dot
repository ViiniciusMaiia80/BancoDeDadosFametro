digraph L {
graph [rankdir=LR, splines=ortho, nodesep=0.35, ranksep=1.1, pad=0.4, bgcolor="white", label=<<B>Modelo Lógico (3FN) - Biblioteca Fametro</B><BR/><FONT POINT-SIZE="10">PK = chave primária | FK = chave estrangeira | UK = única | Pé-de-galinha = lado N; traço = lado 1</FONT>>, labelloc=t, fontname="Helvetica", fontsize=18];
node [shape=plain, fontname="Helvetica"]; edge [color="#444444", arrowhead=tee, arrowtail=crow, dir=both, penwidth=1.1];
"curso" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DEEAF6"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>curso</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_curso"><FONT POINT-SIZE="10"><B>id_curso</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome"><FONT POINT-SIZE="10">nome</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sigla"><FONT POINT-SIZE="10">sigla</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>UK</B></FONT></TD></TR></TABLE>>];
"tipo_usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DEEAF6"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>tipo_usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tipo"><FONT POINT-SIZE="10"><B>id_tipo</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome"><FONT POINT-SIZE="10">nome</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="limite_emprestimos"><FONT POINT-SIZE="10">limite_emprestimos</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prazo_dias"><FONT POINT-SIZE="10">prazo_dias</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="max_renovacoes"><FONT POINT-SIZE="10">max_renovacoes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valor_multa_dia"><FONT POINT-SIZE="10">valor_multa_dia</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR></TABLE>>];
"usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DEEAF6"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10"><B>id_usuario</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="matricula"><FONT POINT-SIZE="10">matricula</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome"><FONT POINT-SIZE="10">nome</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tipo"><FONT POINT-SIZE="10">id_tipo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_curso"><FONT POINT-SIZE="10">id_curso</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ativo"><FONT POINT-SIZE="10">ativo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_cadastro"><FONT POINT-SIZE="10">data_cadastro</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B></B></FONT></TD></TR></TABLE>>];
"categoria" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DEEAF6"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>categoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_categoria"><FONT POINT-SIZE="10"><B>id_categoria</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome"><FONT POINT-SIZE="10">nome</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#C00000"><B>UK</B></FONT></TD></TR></TABLE>>];
