graph DER {
graph [layout=neato, overlap=false, splines=true, sep="+18", bgcolor="white", pad=0.4, outputorder=edgesfirst, label=<<B>DER Conceitual - Biblioteca Fametro</B><BR/><FONT POINT-SIZE="10">Retângulo = entidade (atributo sublinhado = chave primária) | Losango = relacionamento | N / 1 / 0..1 = cardinalidade</FONT>>, labelloc=t, fontname="Helvetica", fontsize=18];
node [fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=11, color="#555555", penwidth=1.2];
"CURSO" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>CURSO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_curso</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a2"><FONT POINT-SIZE="10">sigla</FONT></TD></TR></TABLE>>];
"TIPO_USUARIO" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>TIPO_USUARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_tipo</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a2"><FONT POINT-SIZE="10">limite_emprestimos</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a3"><FONT POINT-SIZE="10">prazo_dias</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a4"><FONT POINT-SIZE="10">max_renovacoes</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a5"><FONT POINT-SIZE="10">valor_multa_dia</FONT></TD></TR></TABLE>>];
"USUARIO" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>USUARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_usuario</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">matricula</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a2"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a3"><FONT POINT-SIZE="10">email</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a4"><FONT POINT-SIZE="10">ativo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a5"><FONT POINT-SIZE="10">data_cadastro</FONT></TD></TR></TABLE>>];
"CATEGORIA" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>CATEGORIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_categoria</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">nome</FONT></TD></TR></TABLE>>];
"EDITORA" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>EDITORA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_editora</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">nome</FONT></TD></TR></TABLE>>];
"AUTOR" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>AUTOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_autor</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">nome</FONT></TD></TR></TABLE>>];
"LIVRO" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>LIVRO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_livro</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">isbn</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a2"><FONT POINT-SIZE="10">titulo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a3"><FONT POINT-SIZE="10">ano_publicacao</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a4"><FONT POINT-SIZE="10">edicao</FONT></TD></TR></TABLE>>];
"EXEMPLAR" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>EXEMPLAR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_exemplar</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">patrimonio</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a2"><FONT POINT-SIZE="10">status</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a3"><FONT POINT-SIZE="10">data_aquisicao</FONT></TD></TR></TABLE>>];
"EMPRESTIMO" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>EMPRESTIMO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_emprestimo</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">data_emprestimo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a2"><FONT POINT-SIZE="10">data_prevista</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a3"><FONT POINT-SIZE="10">data_devolucao</FONT></TD></TR></TABLE>>];
"RENOVACAO" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>RENOVACAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_renovacao</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">numero</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a2"><FONT POINT-SIZE="10">data_renovacao</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a3"><FONT POINT-SIZE="10">nova_data_prevista</FONT></TD></TR></TABLE>>];
"RESERVA" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>RESERVA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_reserva</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">data_reserva</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a2"><FONT POINT-SIZE="10">status</FONT></TD></TR></TABLE>>];
"MULTA" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white" POINT-SIZE="12"><B>MULTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a0"><FONT POINT-SIZE="10"><u>id_multa</u></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a1"><FONT POINT-SIZE="10">dias_atraso</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a2"><FONT POINT-SIZE="10">valor</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a3"><FONT POINT-SIZE="10">status</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a4"><FONT POINT-SIZE="10">data_geracao</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="a5"><FONT POINT-SIZE="10">data_pagamento</FONT></TD></TR></TABLE>>];
r0 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="pertence a", fontsize=10, width=1.5, height=0.8];
"USUARIO" -- r0 [headlabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r0 -- "CURSO" [taillabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r1 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="é do tipo", fontsize=10, width=1.5, height=0.8];
"USUARIO" -- r1 [headlabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r1 -- "TIPO_USUARIO" [taillabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r2 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="classificado em", fontsize=10, width=1.5, height=0.8];
"LIVRO" -- r2 [headlabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r2 -- "CATEGORIA" [taillabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r3 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="publicado por", fontsize=10, width=1.5, height=0.8];
"LIVRO" -- r3 [headlabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r3 -- "EDITORA" [taillabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r4 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="escrito por", fontsize=10, width=1.5, height=0.8];
"LIVRO" -- r4 [headlabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r4 -- "AUTOR" [taillabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r5 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="possui", fontsize=10, width=1.5, height=0.8];
"LIVRO" -- r5 [headlabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r5 -- "EXEMPLAR" [taillabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r6 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="realiza", fontsize=10, width=1.5, height=0.8];
"USUARIO" -- r6 [headlabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r6 -- "EMPRESTIMO" [taillabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r7 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="é emprestado em", fontsize=10, width=1.5, height=0.8];
"EXEMPLAR" -- r7 [headlabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r7 -- "EMPRESTIMO" [taillabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r8 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="pode sofrer", fontsize=10, width=1.5, height=0.8];
"EMPRESTIMO" -- r8 [headlabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r8 -- "RENOVACAO" [taillabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r9 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="pode gerar", fontsize=10, width=1.5, height=0.8];
"EMPRESTIMO" -- r9 [headlabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r9 -- "MULTA" [taillabel="0..1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r10 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="faz", fontsize=10, width=1.5, height=0.8];
"USUARIO" -- r10 [headlabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r10 -- "RESERVA" [taillabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r11 [shape=diamond, style=filled, fillcolor="#FFF2CC", color="#BF9000", label="é reservado em", fontsize=10, width=1.5, height=0.8];
"LIVRO" -- r11 [headlabel="1", labeldistance=2.2, fontcolor="#C00000", len=1.9];
r11 -- "RESERVA" [taillabel="N", labeldistance=2.2, fontcolor="#C00000", len=1.9];
}